{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "telar-blog.vercel.app" }],
      "destination": "https://www.blogtelar.lat/:path*",
      "permanent": true
    }
  ]
}
